{{- $email := promptStringOnce . "email" "Git email address" -}}
{{- $profiles := list "work" "personal" -}}
{{- $profile := promptChoiceOnce . "profile" "Machine profile" $profiles "personal" -}}
# Generated by `chezmoi init` from .chezmoi.toml.tmpl. Stays on this machine so
# the public repo never carries the values that identify it.
[data]
    email = {{ $email | quote }}
    profile = {{ $profile | quote }}
